{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeamMeUp",
  "version": "0.1.0",
  "identifier": "com.breizhzion.beammeup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "BeamMeUp",
        "width": 1000,
        "height": 650,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "BREIZHZION",
    "copyright": "© 2026 BREIZHZION, BZ-1.1 License",
    "homepage": "https://beammeup.breizhzion.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
